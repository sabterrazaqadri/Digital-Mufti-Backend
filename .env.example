# ===== AI Mufti backend environment =====
# Copy to .env and fill with your OWN (rotated) values. Never commit .env.

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBED_MODEL=models/gemini-embedding-001
# Max tokens generated per reply. Urdu/Arabic script is token-heavy, so keep this
# high enough that long rulings are not truncated mid-sentence.
MAX_OUTPUT_TOKENS=8192

# Postgres (Neon). Keep this secret.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Better Auth — the backend verifies session JWTs against the Next app's JWKS.
# Set this to the public URL of your Next.js app (Better Auth baseURL).
BETTER_AUTH_URL=http://localhost:3000
# Optional explicit override:
# BETTER_AUTH_JWKS_URL=https://your-app.vercel.app/api/auth/jwks

# Comma-separated allowed origins for CORS
CORS_ORIGINS=https://digitalmufti.vercel.app,http://localhost:3000

# ===== Admin (video-item review queue at /admin/video-items) =====
# Who may curate the AutoTube content pool. Identity still comes only from a verified
# Better Auth JWT; this says which verified identities are allowed to approve items.
# With BOTH unset, every admin route returns 503 — an unconfigured allowlist must
# never mean "everyone".
ADMIN_EMAILS=you@example.com
# Fallback when your JWT carries no email claim. Find your id at GET /api/admin/whoami.
# ADMIN_USER_IDS=

# ===== AutoTube feed (/api/autotube/*) =====
# Shared secret AutoTube sends as `Authorization: Bearer <key>`. Compared in constant
# time; every authenticated route 503s while it is unset, so the feed is off by
# default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTOTUBE_SERVICE_KEY=
# Kill switch. Set to false to stop serving items (/next and /ack return 503) without
# touching code or routing — one env-var flip shuts the feed off.
AUTOTUBE_API_ENABLED=true
# Model used by the OFFLINE batch extraction agent (extract_video_items.py). Nothing
# in the request path ever calls a model — the feed is a plain database lookup.
EXTRACTOR_MODEL=gemini-3.6-flash
# Optional: how long an AutoTube run holds a reserved item before it returns to the
# tenant's pool, and the per-tenant hourly request cap.
# AUTOTUBE_RESERVE_HOURS=6
# AUTOTUBE_RATE_LIMIT=20
